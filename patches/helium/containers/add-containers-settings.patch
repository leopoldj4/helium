+#include "components/containers/browser/prefs.h"
+
+#include <utility>
+
+#include "base/logging.h"
+#include "base/values.h"
+#include "components/containers/browser/pref_names.h"
+#include "components/containers/mojom/containers.mojom.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace containers {
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(prefs::kContainersList);
+}
+
+std::vector<mojom::ContainerPtr> GetContainersFromPrefs(
+    const PrefService& prefs) {
+  std::vector<mojom::ContainerPtr> containers;
+  for (const auto& container : prefs.GetList(prefs::kContainersList)) {
+    if (!container.is_dict()) {
+      LOG(ERROR) << "Container pref entry is not a dictionary";
+      continue;
+    }
+
+    const base::DictValue& dict = container.GetDict();
+    const std::string* id = dict.FindString("id");
+    const std::string* name = dict.FindString("name");
+    if (!id || !name) {
+      LOG(ERROR) << "Container pref entry is missing id or name";
+      continue;
+    }
+
+    containers.push_back(mojom::Container::New(*id, *name));
+  }
+  return containers;
+}
+
+void SetContainersToPrefs(const std::vector<mojom::ContainerPtr>& containers,
+                          PrefService& prefs) {
+  base::ListValue list;
+  for (const auto& container : containers) {
+    list.Append(base::DictValue()
+                    .Set("id", container->id)
+                    .Set("name", container->name));
+  }
+  prefs.SetList(prefs::kContainersList, std::move(list));
+}
+
+}  // namespace containers
