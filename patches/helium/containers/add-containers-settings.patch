+    <div slot="body">
+      <cr-input id="containerName" value="{{editingContainer_.name}}"
+          autofocus required auto-validate pattern="^.*\\S.*$"
+          label="$i18n{containersContainerName}"
+          placeholder="$i18n{containersContainerNamePlaceholder}"
+          on-input="onContainerNameInput_">
