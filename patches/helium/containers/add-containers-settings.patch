+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import '../settings_shared.css.js';
+
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {assert} from 'chrome://resources/js/assert.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {Container} from '../containers.mojom-webui.js';
+import {ContainerOperationError} from '../containers.mojom-webui.js';
+
+import {ContainersSettingsBrowserProxy} from './containers_browser_proxy.js';
+import {getTemplate} from './containers_section.html.js';
+
+const SettingsContainersSectionElementBase = I18nMixin(PolymerElement);
+
+export class SettingsContainersSectionElement extends
+    SettingsContainersSectionElementBase {
+  static get is() {
+    return 'settings-containers-section';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      containersList_: {
+        type: Array,
+        value: () => [],
+      },
+      editingContainer_: Object,
+      deletingContainer_: Object,
+      isEditDialogNameInvalid_: {
+        type: Boolean,
+        value: false,
+      },
+      editDialogError_: String,
+      deleteDialogError_: String,
+    };
+  }
+
+  declare private containersList_: Container[];
+  declare private editingContainer_: Container|undefined;
+  declare private deletingContainer_: Container|undefined;
+  declare private isEditDialogNameInvalid_: boolean;
+  declare private editDialogError_: string|undefined;
+  declare private deleteDialogError_: string|undefined;
+
+  private browserProxy_: ContainersSettingsBrowserProxy =
+      ContainersSettingsBrowserProxy.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.browserProxy_.handler.getContainers().then(({containers}) => {
+      this.onContainersChanged_(containers);
+    });
+    this.browserProxy_.callbackRouter.onContainersChanged.addListener(
+        this.onContainersChanged_.bind(this));
+  }
+
+  private onContainersChanged_(containers: Container[]) {
+    this.containersList_ = containers;
+  }
+
+  private onAddClick_() {
+    this.editingContainer_ = {id: '', name: ''};
+    this.isEditDialogNameInvalid_ = false;
+    this.editDialogError_ = undefined;
+  }
+
+  private onEditClick_(event: Event) {
+    const item = (event as any).model.item as Container;
+    this.editingContainer_ = {...item};
+    this.isEditDialogNameInvalid_ = false;
+    this.editDialogError_ = undefined;
+  }
+
+  private onDeleteClick_(event: Event) {
+    const item = (event as any).model.item as Container;
+    this.deletingContainer_ = item;
+    this.deleteDialogError_ = undefined;
+  }
+
+  private onDialogClosed_() {
+    this.editingContainer_ = undefined;
+    this.deletingContainer_ = undefined;
+  }
+
+  private onCancelDialogClick_() {
+    this.editingContainer_ = undefined;
+    this.deletingContainer_ = undefined;
+  }
+
+  private onContainerNameInput_(event: InputEvent) {
+    const input = event.target as CrInputElement;
+    this.isEditDialogNameInvalid_ = input.invalid;
+  }
+
+  private async onSaveClick_() {
+    assert(this.editingContainer_);
+    const container = this.editingContainer_;
+    const {error} = container.id ?
+        await this.browserProxy_.handler.updateContainer(container) :
+        await this.browserProxy_.handler.addContainer(container);
+
+    if (error === null) {
+      this.editingContainer_ = undefined;
+      return;
+    }
+
+    this.editDialogError_ = this.formatError_(error);
+  }
+
+  private async onConfirmDeleteClick_() {
+    assert(this.deletingContainer_);
+    const {error} = await this.browserProxy_.handler.removeContainer(
+        this.deletingContainer_.id);
+
+    if (error === null) {
+      this.deletingContainer_ = undefined;
+      return;
+    }
+
+    this.deleteDialogError_ = this.formatError_(error);
+  }
+
+  private getEditDialogTitle_(id: string): string {
+    return id ? this.i18n('containersEditContainer') :
+                this.i18n('containersAddContainer');
+  }
+
+  private isSaveDisabled_(name: string, isNameInvalid: boolean): boolean {
+    return !name || isNameInvalid;
+  }
+
+  private formatError_(error: ContainerOperationError): string {
+    switch (error) {
+      case ContainerOperationError.kNotFound:
+        return this.i18n(
+            'containersErrorTemplate',
+            this.i18n('containersErrorNotFound'));
+      case ContainerOperationError.kInvalidName:
+        return this.i18n(
+            'containersErrorTemplate',
+            this.i18n('containersErrorInvalidName'));
+      default:
+        return this.i18n('containersErrorTemplate', `${error}`);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-containers-section': SettingsContainersSectionElement;
+  }
+}
+
+customElements.define(
+    SettingsContainersSectionElement.is, SettingsContainersSectionElement);
